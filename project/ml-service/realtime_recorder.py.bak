"""
Real-time Recording with 480p Resolution
- Continuous recording to H.264 MP4
- 7-day retention
- MongoDB GridFS storage
- Automatic chunk creation and upload
"""

import cv2
import os
import subprocess
import requests
from datetime import datetime, timedelta
import logging
import threading
import queue as thread_queue
from pymongo import MongoClient
from pymongo.errors import ServerSelectionTimeoutError
import json

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class RealtimeVideoRecorder:
    """480p continuous video recorder with MongoDB upload"""
    
    def __init__(self, camera_id="camera_1", output_dir="storage/videos"):
        self.camera_id = camera_id
        self.output_dir = output_dir
        self.resolution = (640, 480)  # 480p
        self.fps = 15
        
        # Pick the best browser-compatible codec available on this system.
        # avc1 / H264 → H.264 (Chrome, Firefox, Edge all support this natively)
        # mp4v        → MPEG-4 Part 2 (browsers do NOT support – last resort)
        self.codec, self.codec_name = self._pick_codec()
        
        # Create output directory
        os.makedirs(output_dir, exist_ok=True)
        
        # Current recording
        self.current_video = None
        self.current_filename = None
        self.recording_start_time = None
        self.chunk_duration = 60  # 1 minute per chunk for testing
        self.frame_count = 0
        
        # MongoDB connection (thread-safe queue)
        self.upload_queue = thread_queue.Queue()
        self.start_upload_thread()
        
        # Frame writing thread
        self.frame_queue = thread_queue.Queue(maxsize=150)
        self.running = True
        self.record_thread = threading.Thread(target=self._record_worker, daemon=True)
        self.record_thread.start()
        
        # File storage fallback
        self.recordings_file = "storage/analytics_recordings.json"
        self.ensure_recordings_file()
        
        logger.info(f"Video recorder initialized: {self.resolution}, {self.fps} FPS, {self.codec}")
    
    def _pick_codec(self):
        """Choose the best H.264-compatible codec available on this machine."""
        os.makedirs(self.output_dir, exist_ok=True)
        probe_path = os.path.join(self.output_dir, '_codec_probe.mp4')
        for name in ('avc1', 'H264', 'X264', 'mp4v'):
            fourcc = cv2.VideoWriter_fourcc(*name)
            writer = cv2.VideoWriter(probe_path, fourcc, self.fps, self.resolution)
            if writer.isOpened():
                writer.release()
                try:
                    os.remove(probe_path)
                except OSError:
                    pass
                logger.info(f"Using video codec: {name} (browser-compatible: {name != 'mp4v'})")
                return fourcc, name
            writer.release()
        # absolute fallback
        logger.warning("No H.264 codec found – falling back to mp4v (may not play in browser)")
        return cv2.VideoWriter_fourcc(*'mp4v'), 'mp4v'

    def ensure_recordings_file(self):
        """Ensure recordings JSON file exists"""
        os.makedirs("storage", exist_ok=True)
        if not os.path.exists(self.recordings_file):
            with open(self.recordings_file, 'w') as f:
                json.dump([], f)
    
    def create_new_recording(self):
        """Create new video file"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"surveillance_{self.camera_id}_{timestamp}.mp4"
        filepath = os.path.join(self.output_dir, filename)
        
        try:
            self.current_video = cv2.VideoWriter(
                filepath,
                self.codec,
                self.fps,
                self.resolution
            )
            
            if not self.current_video.isOpened():
                logger.error(f"Failed to open video writer for {filepath}")
                return None
            
            self.current_filename = filepath
            self.recording_start_time = datetime.now()
            self.frame_count = 0
            
            logger.info(f"Started recording: {filename}")
            return filepath
        
        except Exception as e:
            logger.error(f"Error creating video file: {e}")
            return None
    
    def write_frame(self, frame):
        """Queue frame for writing to video"""
        if not self.running:
            return False
            
        if not self.frame_queue.full():
            self.frame_queue.put(frame.copy())
            return True
        else:
            logger.warning("Recording queue full, dropping frame")
            return False
            
    def _record_worker(self):
        """Background worker to write frames"""
        while self.running:
            try:
                frame = self.frame_queue.get(timeout=1)
                
                if self.current_video is None:
                    self.create_new_recording()
                
                if self.current_video is not None:
                    frame_resized = cv2.resize(frame, self.resolution)
                    self.current_video.write(frame_resized)
                    self.frame_count += 1
                    
                    elapsed = (datetime.now() - self.recording_start_time).total_seconds()
                    if elapsed > self.chunk_duration:
                        self.finalize_chunk()
            except thread_queue.Empty:
                continue
            except Exception as e:
                logger.error(f"Error in recording worker: {e}")
    
    def finalize_chunk(self):
        """Finalize current recording chunk"""
        if self.current_video is None:
            return
        
        try:
            self.current_video.release()
            self.current_video = None
            
            # Try to transcode to H264 for browser compatibility (background thread)
            if self.current_filename and os.path.exists(self.current_filename):
                src = self.current_filename
                threading.Thread(
                    target=self._try_ffmpeg_transcode,
                    args=(src,),
                    daemon=True
                ).start()
            
            # Queue for upload
            if self.current_filename and os.path.exists(self.current_filename):
                file_size = os.path.getsize(self.current_filename)
                self.upload_queue.put({
                    'filepath': self.current_filename,
                    'camera_id': self.camera_id,
                    'start_time': self.recording_start_time,
                    'end_time': datetime.now(),
                    'duration': (datetime.now() - self.recording_start_time).total_seconds(),
                    'file_size': file_size,
                    'frames': self.frame_count
                })
                
                logger.info(f"Queued for upload: {self.current_filename} ({file_size / 1024 / 1024:.2f} MB)")
        
        except Exception as e:
            logger.error(f"Error finalizing chunk: {e}")

    def _try_ffmpeg_transcode(self, filepath):
        """Re-encode a video file to H.264 MP4 using FFmpeg (browser-compatible).
        Replaces the original file in-place. Silent no-op if FFmpeg is not installed."""
        tmp_path = filepath + '.h264tmp.mp4'
        try:
            result = subprocess.run(
                [
                    'ffmpeg', '-y',
                    '-i', filepath,
                    '-c:v', 'libx264',
                    '-preset', 'fast',
                    '-crf', '23',
                    '-movflags', '+faststart',  # metadata at front for streaming
                    tmp_path
                ],
                capture_output=True,
                timeout=120
            )
            if result.returncode == 0 and os.path.exists(tmp_path):
                os.replace(tmp_path, filepath)  # atomic swap
                logger.info(f"[FFmpeg] Transcoded to H264: {os.path.basename(filepath)}")
            else:
                logger.warning(f"[FFmpeg] Transcode failed (rc={result.returncode}): {result.stderr.decode(errors='ignore')[-200:]}")
        except FileNotFoundError:
            logger.debug("[FFmpeg] Not installed – skipping H264 transcode")
        except subprocess.TimeoutExpired:
            logger.warning(f"[FFmpeg] Transcode timed out for {os.path.basename(filepath)}")
        except Exception as e:
            logger.error(f"[FFmpeg] Transcode error: {e}")
        finally:
            if os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except OSError:
                    pass
    
    def start_upload_thread(self):
        """Start background thread for MongoDB uploads"""
        thread = threading.Thread(target=self._upload_worker, daemon=True)
        thread.start()
        logger.info("Upload worker thread started")
    
    def _upload_worker(self):
        """Background worker for uploading videos to MongoDB"""
        while True:
            try:
                upload_task = self.upload_queue.get(timeout=10)
                self._upload_to_mongodb(upload_task)
            except thread_queue.Empty:
                continue
            except Exception as e:
                logger.error(f"Upload worker error: {e}")
    
    def _upload_to_mongodb(self, task):
        """Skip MongoDB completely and use file storage to prevent Laravel sync issues"""
        logger.info("Using local file storage to bypass MongoDB DNS issues")
        self._store_to_file_fallback(task)
    
    def _store_to_file_fallback(self, task):
        """Store recording metadata to JSON file (fallback)"""
        try:
            with open(self.recordings_file, 'r') as f:
                recordings = json.load(f)
            
            recording_entry = {
                'filename': os.path.basename(task['filepath']),
                'camera_id': task['camera_id'],
                'start_time': task['start_time'].isoformat(),
                'end_time': task['end_time'].isoformat(),
                'duration': task['duration'],
                'file_size': task['file_size'],
                'frames': task['frames'],
                'stored_at': datetime.now().isoformat(),
                'storage': 'local'
            }
            
            recordings.append(recording_entry)
            
            # Post to Laravel
            try:
                api_url = os.getenv('API_URL', 'http://localhost:8000/api')
                payload = {
                    'camera_id': task['camera_id'],
                    'filename': os.path.basename(task['filepath']),
                    'filepath': os.path.abspath(task['filepath']).replace('\\', '/'),
                    'duration_seconds': int(task['duration']),
                    'people_count': 0,
                    'file_size_bytes': task['file_size'],
                    'frame_count': task['frames']
                }
                requests.post(f"{api_url}/recordings", json=payload, timeout=5)
            except Exception as e:
                logger.error(f"Failed to notify Laravel: {e}")
            
            # Keep only last 7 days
            cutoff = datetime.now() - timedelta(days=7)
            recordings = [r for r in recordings 
                         if datetime.fromisoformat(r['start_time']) > cutoff]
            
            with open(self.recordings_file, 'w') as f:
                json.dump(recordings, f, indent=2)
            
            logger.info(f"Stored to file fallback: {os.path.basename(task['filepath'])}")
        
        except Exception as e:
            logger.error(f"File fallback error: {e}")
    
    def _cleanup_old_recordings(self, db, camera_id):
        """Remove recordings older than 7 days"""
        try:
            from gridfs import GridFS
            fs = GridFS(db)
            
            cutoff = datetime.now() - timedelta(days=7)
            
            old_records = db.recordings.find({
                'camera_id': camera_id,
                'start_time': {'$lt': cutoff}
            })
            
            count = 0
            for record in old_records:
                try:
                    fs.delete(record['file_id'])
                    db.recordings.delete_one({'_id': record['_id']})
                    count += 1
                except Exception as e:
                    logger.error(f"Error deleting old recording: {e}")
            
            if count > 0:
                logger.info(f"Cleaned up {count} old recordings for {camera_id}")
        
        except Exception as e:
            logger.error(f"Cleanup error: {e}")
    
    def get_recording_stats(self):
        """Get recording statistics"""
        try:
            total_size = 0
            file_count = 0
            
            if os.path.exists(self.output_dir):
                for filename in os.listdir(self.output_dir):
                    filepath = os.path.join(self.output_dir, filename)
                    if os.path.isfile(filepath):
                        total_size += os.path.getsize(filepath)
                        file_count += 1
            
            return {
                'recording_count': file_count,
                'total_size_mb': total_size / 1024 / 1024,
                'current_file': self.current_filename,
                'current_frames': self.frame_count,
                'queue_size': self.upload_queue.qsize()
            }
        
        except Exception as e:
            logger.error(f"Stats error: {e}")
            return {}
    
    def stop_recording(self):
        """Stop recording and finalize"""
        self.running = False
        if hasattr(self, 'record_thread'):
            self.record_thread.join(timeout=2)
        self.finalize_chunk()
        logger.info("Recording stopped")


def test_recorder():
    """Test video recorder"""
    recorder = RealtimeVideoRecorder()
    
    cap = cv2.VideoCapture(0)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_FPS, 30)
    
    logger.info("Starting recorder test...")
    
    frame_count = 0
    while frame_count < 300:  # ~10 seconds at 30 FPS
        ret, frame = cap.read()
        if not ret:
            break
        
        recorder.write_frame(frame)
        frame_count += 1
        
        if frame_count % 30 == 0:
            logger.info(f"Recorded {frame_count} frames")
    
    recorder.stop_recording()
    cap.release()
    
    logger.info(f"Test complete. Stats: {recorder.get_recording_stats()}")


if __name__ == "__main__":
    test_recorder()
